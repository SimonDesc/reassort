{
  "compilerOptions": {
    "target": "es2023", "module": "esnext", "moduleResolution": "bundler", "moduleDetection": "force", "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "noEmit": true, "skipLibCheck": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
