{
  "compilerOptions": {
    "target": "es2023", "moduleDetection": "force", "verbatimModuleSyntax": true, "allowImportingTsExtensions": true, "erasableSyntaxOnly": true, "noEmit": true, "skipLibCheck": true, "strict": true, "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
